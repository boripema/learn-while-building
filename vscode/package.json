{
  "name": "learn-while-building-visual",
  "displayName": "Learn while Building \u2014 Test Alpha",
  "description": "Focused visual steps, highlighted source and optional local Python practice.",
  "version": "0.2.1",
  "publisher": "boripema",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education"
  ],
  "main": "./extension.js",
  "scripts": {
    "vscode:prepublish": "node scripts/prepare.cjs"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "learnVisual.open",
        "title": "Learn: Open visual learning tab"
      },
      {
        "command": "learnVisual.refresh",
        "title": "Learn: Refresh project map"
      },
      {
        "command": "learnVisual.usage",
        "title": "Learn: Show local usage"
      }
    ],
    "configuration": {
      "title": "Learn while Building",
      "properties": {
        "learnVisual.python": {
          "type": "string",
          "default": "python3",
          "description": "Python 3 executable for local source indexing. No model is called."
        },
        "learnVisual.dataDirectory": {
          "type": "string",
          "default": "",
          "description": "Shared visual cache directory. Default: LEARN_DIR/visual or ~/.learning/visual."
        },
        "learnVisual.autoRefreshOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Update this workspace's graph locally after source files are saved."
        }
      }
    }
  }
}
